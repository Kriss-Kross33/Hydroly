{
  "name": "expo-app",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "ENVFILE=.env.staging expo start",
    "start:stg": "ENVFILE=.env.staging expo start",
    "start:prod": "ENVFILE=.env.production NODE_ENV=production expo start",
    "start-web": "expo start --web",
    "start-web-dev": "DEBUG=expo* expo start --web --tunnel",
    "android": "ENVFILE=.env.staging NODE_ENV=development expo run:android --variant devDebug",
    "ios": "ENVFILE=.env.staging expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "test": "echo 'No tests configured yet'",
    "ios:dev": "ENVFILE=.env.staging NODE_ENV=development expo run:ios --scheme HydrationTrackerApp",
    "ios:stg": "ENVFILE=.env.staging NODE_ENV=staging expo run:ios --scheme HydrationTrackerApp",
    "ios:stg:debug": "ENVFILE=.env.staging NODE_ENV=staging expo run:ios --scheme HydrationTrackerApp",
    "ios:prod": "ENVFILE=.env.production NODE_ENV=production expo run:ios --scheme HydrationTrackerApp",
    "ios:prod:debug": "ENVFILE=.env.production NODE_ENV=production expo run:ios --scheme HydrationTrackerApp",
    "android:dev": "ENVFILE=.env.staging NODE_ENV=development expo run:android --variant devDebug",
    "android:stg": "ENVFILE=.env.staging NODE_ENV=staging expo run:android --variant stgRelease",
    "android:stg:debug": "ENVFILE=.env.staging NODE_ENV=staging expo run:android --variant stgDebug",
    "android:stg:apk": "cd android && ENVFILE=.env.staging ./gradlew assembleStgRelease",
    "android:stg:bundle": "cd android && ENVFILE=.env.staging ./gradlew bundleStgRelease",
    "android:prod:apk": "cd android && ENVFILE=.env.production ./gradlew assembleProdRelease",
    "android:prod:bundle": "cd android && ENVFILE=.env.production ./gradlew bundleProdRelease",
    "android:prod": "ENVFILE=.env.production NODE_ENV=production expo run:android --variant prodRelease",
    "android:prod:debug": "ENVFILE=.env.production NODE_ENV=production expo run:android --variant prodDebug"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@hydroly/crashlytics": "file:./packages/crashlytics",
    "@hydroly/firebase-auth": "file:./packages/firebase-auth",
    "@hydroly/local-storage-api": "file:./packages/local-storage-api",
    "@hydroly/push-notifications": "file:./packages/push_notifications",
    "@hydroly/realm-repository": "file:./packages/realm-repository",
    "@hydroly/remote-config-service": "file:./packages/remote_config_service",
    "@hydroly/revenuecat-service": "file:./packages/revenuecat-service",
    "@nkzw/create-context-hook": "^1.1.0",
    "@notifee/react-native": "^8.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/app": "^22.4.0",
    "@react-native-firebase/auth": "^22.4.0",
    "@react-native-firebase/crashlytics": "^22.2.1",
    "@react-native-firebase/messaging": "^22.2.0",
    "@react-native-firebase/remote-config": "^22.2.0",
    "@react-native-google-signin/google-signin": "^13.2.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.13",
    "@react-navigation/stack": "^7.2.9",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.90.12",
    "@ungap/structured-clone": "^1.3.0",
    "axios": "^1.13.2",
    "expo": "~54.0.27",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.11",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.15",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "lucide-react-native": "^0.562.0",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-config": "^1.6.1",
    "react-native-css-interop": "^0.2.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^8.12.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-stallion": "^2.3.1",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-react-jsx": "^7.25.0",
    "@expo/cli": "~54.0.0",
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~11.0.0",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "private": true,
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "react-native": "0.81.5",
    "@realm/react/react-native": "0.81.5"
  }
}
